# SmartBudget AI — Docker local evaluation environment
#
# Copy this file to `.env` and fill in real values before running:
#   docker compose up --build
#
# NEVER commit the real `.env` file (it is already listed in .gitignore).

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=smartbudget
POSTGRES_USER=smartbudget
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# --- JWT -----------------------------------------------------------------
# Jwt__Key must be at least 32 bytes (32+ characters) or the API will refuse
# to start. Generate one, e.g.:
#   openssl rand -base64 32           (macOS/Linux)
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))   (PowerShell)
JWT_KEY=<YOUR_JWT_KEY_MIN_32_CHARS>
JWT_ISSUER=SmartBudget.Api
JWT_AUDIENCE=SmartBudget.Mobile
# Must stay 60 — the API enforces this exact value for the current MVP build.
JWT_EXPIRATION_MINUTES=60

# --- AI / OpenAI (optional for local evaluation) -------------------------
# Leave the placeholder to run the app without AI features; AI endpoints
# will use their existing fallback behavior instead of failing the app.
AI_API_KEY=<YOUR_OPENAI_API_KEY>
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1/responses

# --- ASP.NET Core ----------------------------------------------------------
# Development enables Swagger UI at /swagger, useful for local evaluation.
ASPNETCORE_ENVIRONMENT=Development
